# =============================================================================
# ARCOMPT — variables de production.
#
#   cp infra/env/prod.env.example infra/env/prod.env
#   chmod 600 infra/env/prod.env
#   # puis remplir, et NE JAMAIS committer infra/env/prod.env
#
# Ce fichier est lu par :
#   docker compose --env-file infra/env/prod.env -f docker-compose.prod.yml up -d
#
# Les variables marquées « OBLIGATOIRE » font échouer la commande si elles sont
# vides. Celles marquées « REFUS DE DÉMARRAGE » sont vérifiées une seconde fois
# par l'API elle-même (apps/api/src/config.ts, et createMailerFromEnv() pour
# l'envoi d'e-mails) : sans elles, le conteneur api s'arrête en disant
# lesquelles manquent. C'est voulu : ARCOMPT ne sert jamais
# une comptabilité depuis un simulateur.
#
# Fabriquer un secret :   openssl rand -base64 32
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Noms de domaine et certificats                              (OBLIGATOIRE)
# -----------------------------------------------------------------------------
# Quatre noms doivent DÉJÀ résoudre vers l'IP du serveur avant le premier
# démarrage : arcompt.com, www.arcompt.com, api.arcompt.com, auth.arcompt.com.
# Caddy demande les certificats dès qu'il démarre ; si un nom ne résout pas
# encore, la demande échoue et consomme le quota Let's Encrypt.
# Enregistrements exacts à créer chez GoDaddy : docs/DEPLOYMENT.md § 4.
#
# WEB_DOMAIN est le nom CANONIQUE (sans www) : www y est redirigé par Caddy.
WEB_DOMAIN=arcompt.com
API_DOMAIN=api.arcompt.com
AUTH_DOMAIN=auth.arcompt.com
# Adresse prévenue par Let's Encrypt si un renouvellement échoue.
ACME_EMAIL=exploitation@arcompt.com

# -----------------------------------------------------------------------------
# 2. Images à déployer
# -----------------------------------------------------------------------------
# Publiées par .github/workflows/release.yml. Épingler un SHA ou une version
# plutôt que « latest » : c'est ce qui rend le retour arrière possible.
API_IMAGE=ghcr.io/<organisation>/arcompt-api:v0.1.0
WEB_IMAGE=ghcr.io/<organisation>/arcompt-web:v0.1.0

# -----------------------------------------------------------------------------
# 3. PostgreSQL                                                  (OBLIGATOIRE)
# -----------------------------------------------------------------------------
# Propriétaire du schéma : utilisé UNIQUEMENT par la tâche de migration.
POSTGRES_USER=arcompt
POSTGRES_PASSWORD=
POSTGRES_DB=arcompt

# Rôle de connexion de l'application : membre de arcompt_app, soumis à la
# Row-Level Security, sans DDL. Créé par la tâche de migration
# (infra/docker/ops/provision-role.mjs → packages/db/src/provision.ts).
# 16 caractères minimum ; « arcompt », « postgres », « changeme » sont refusés.
APP_DB_USER=arcompt_app_login
APP_DB_PASSWORD=

# -----------------------------------------------------------------------------
# 4. Authentification Keycloak                                   (OBLIGATOIRE)
# -----------------------------------------------------------------------------
KEYCLOAK_REALM=arcompt
# Compte d'amorçage de la console Keycloak. À n'utiliser qu'une fois, pour créer
# un administrateur nominatif ; vider ensuite ces deux lignes.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# ATTENTION — deux identifiants de client DIFFÉRENTS, tous deux transmis sous le
# nom KEYCLOAK_CLIENT_ID mais à deux services distincts :
#   * le web se connecte avec le client « code flow » (confidentiel) ;
#   * l'API n'accepte que les jetons dont l'AUDIENCE est le client bearer-only.
# Il faut donc, dans Keycloak, un « Audience mapper » sur le client web qui
# ajoute KEYCLOAK_API_AUDIENCE dans le claim `aud`. Sans lui : 401 partout.
KEYCLOAK_WEB_CLIENT_ID=arcompt-web
KEYCLOAK_WEB_CLIENT_SECRET=
KEYCLOAK_API_AUDIENCE=arcompt-api

# Secret de session Auth.js côté web (openssl rand -base64 32).
AUTH_SECRET=

# -----------------------------------------------------------------------------
# 5. Secrets applicatifs                              (REFUS DE DÉMARRAGE)
# -----------------------------------------------------------------------------
# Clé maître de chiffrement de la paie : base64 de 32 octets EXACTEMENT.
#   openssl rand -base64 32
# La perdre rend les données de paie déjà enregistrées indéchiffrables :
# à sauvegarder hors du serveur, comme un secret bancaire.
PAYROLL_ENCRYPTION_KEY=

# Signature HMAC des webhooks Meta. EXIGÉE MÊME SI WHATSAPP N'EST PAS UTILISÉ :
# il n'existe aucun opt-out pour cette variable. Sans elle, l'API ne démarre pas.
# Si WhatsApp n'est pas branché, y mettre une valeur aléatoire suffit.
WHATSAPP_APP_SECRET=

# -----------------------------------------------------------------------------
# 6. Dépendances externes : réelles, ou repli explicitement assumé
# -----------------------------------------------------------------------------
# Chaque bloc ci-dessous a la même forme : soit les variables réelles, soit
# l'opt-out ALLOW_INSECURE_* correspondant. Un opt-out est une décision, pas un
# oubli : `grep -r ALLOW_INSECURE_ infra/env/prod.env` doit toujours se relire
# sans surprise. Pour une PREMIÈRE MISE EN LIGNE de test, les cinq opt-out
# sont acceptables ; ils ne le sont pas pour une comptabilité réelle — un
# ALLOW_INSECURE_MAIL posé, en particulier, rend toute invitation au portail
# inutilisable, puisque son code à usage unique ne parviendra à personne.

# --- Extraction IA des pièces (Anthropic) ---
# Sans clé, l'extraction est SIMULÉE : fournisseur et montants inventés entrent
# dans la file de validation.
ANTHROPIC_API_KEY=
AI_MODEL=
ALLOW_INSECURE_AI=1

# --- Stockage objet des pièces (Cloudflare R2) ---
# Sans les quatre variables, les pièces vont sur un volume Docker local. La
# conservation décennale AUDCIF demande un stockage objet sauvegardé.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
ALLOW_INSECURE_STORAGE=1

# --- Antivirus (clamd) ---
# Sans CLAMAV_HOST, tout fichier téléversé est accepté sans analyse.
CLAMAV_HOST=
CLAMAV_PORT=3310
ALLOW_INSECURE_ANTIVIRUS=1

# --- Canal WhatsApp (Meta Cloud API) ---
# Sans jeton NI identifiant de téléphone, les messages sortants sont avalés.
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
ALLOW_INSECURE_WHATSAPP=1

# --- Envoi des e-mails (SMTP, fournisseur au choix) ---
# Sans SMTP_HOST NI MAIL_FROM_ADDRESS, rien ne part : invitations au portail,
# demandes de pièces, notifications d'accès administrateur et relances de
# règlement seraient seulement écrites dans les journaux du conteneur.
# Le code ne nomme aucun fournisseur : tout service parlant SMTP convient, y
# compris le relais déjà utilisé par un autre produit de la maison.
# SMTP_SECURE=1 pour le port 465 (TLS dès la connexion) ; sur 587, STARTTLS est
# exigé. SMTP_USER/SMTP_PASSWORD sont facultatifs si le relais authentifie par
# adresse IP.
#
# AVANT LA PREMIÈRE MISE EN LIGNE : le domaine de MAIL_FROM_ADDRESS doit publier
# un enregistrement SPF autorisant ce fournisseur et un enregistrement DKIM
# portant sa clé publique (docs/OPERATIONS.md § « Envoi des e-mails »). Sans eux,
# les messages seront classés en indésirables ou rejetés.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ARCOMPT
MAIL_REPLY_TO=
# Mentions légales en pied de chaque message : raison sociale, adresse, RCCM,
# contact. Laissées vides, un texte de rappel part à la place, visible du client.
MAIL_LEGAL_FOOTER=
# REFUS DE DÉMARRAGE : sans les deux variables ci-dessus, l'API s'arrête au
# montage des routes, sauf opt-out ci-dessous.
ALLOW_INSECURE_MAIL=1

# --- Encaissement mobile money ---
# Laisser VIDE : aucun opérateur réel n'est implémenté, et « mock » est refusé
# en production sans opt-out possible. Vide = fonction désactivée proprement.
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
# Obligatoire seulement si PAYMENT_PROVIDER est renseigné : 32 caractères
# minimum, et « mock-secret » est explicitement refusé.
PAYMENT_WEBHOOK_SECRET=

# --- Facture certifiée (FNE / MECeF) ---
# Laisser VIDE. « mock » imprimerait une référence fiscale inventée sur les
# factures de vos clients : refusé en production, sans opt-out.
CERTIFICATION_CONNECTOR=

# -----------------------------------------------------------------------------
# 7. Réglages applicatifs (facultatifs)
# -----------------------------------------------------------------------------
DEFAULT_LOCALE=fr
DEFAULT_CURRENCY=XOF
DEFAULT_COUNTRY_PACK=ci
DEFAULT_FISCAL_YEAR=
JOBS_PREFIX=arcompt
MAX_DOCUMENT_BYTES=15728640
# Attente maximale du verrou de migration, en secondes.
MIGRATION_LOCK_TIMEOUT=300
# Arrêt en douceur de l'API : délai laissé aux requêtes en cours après SIGTERM
# (millisecondes, 10 000 par défaut). Doit rester SOUS STOP_GRACE_PERIOD, sinon
# Docker tue le processus avant qu'il ait fini.
SHUTDOWN_GRACE_MS=10000
# Patience de Docker avant SIGKILL, pour l'API et le worker.
STOP_GRACE_PERIOD=20s

# -----------------------------------------------------------------------------
# 8. Observabilité (facultative)
# -----------------------------------------------------------------------------
# Sans ces variables, il reste les journaux structurés (docker compose logs).
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
# Puits des alertes de sécurité (rafales d'échecs d'authentification, rejets RLS,
# signatures de webhook invalides). Sans lui, ces signaux ne réveillent personne.
SECURITY_ALERT_WEBHOOK_URL=
