# =============================================================================
# ARCOMPT — modèle d'environnement
#
# Ce fichier est prévu pour le DÉVELOPPEMENT LOCAL : copiez-le en `.env` et il
# fonctionne tel quel, en simulant l'IA, l'antivirus, le stockage objet, le
# canal WhatsApp, l'opérateur de paiement et la certification fiscale.
#
# En production (`NODE_ENV=production`), l'API REFUSE DE DÉMARRER tant que ces
# simulations ne sont pas remplacées par des services réels : `loadConfig()`
# (apps/api/src/config.ts) rassemble tous les problèmes et lève une erreur les
# listant. Les blocs marqués « ⚠ PRODUCTION » ci-dessous sont ceux à changer.
#
# Un repli simulé peut, à titre exceptionnel, être accepté en production en
# posant l'opt-out `ALLOW_INSECURE_*=1` correspondant : c'est une décision
# délibérée et greppable (`grep -r ALLOW_INSECURE_`), jamais un accident.
# =============================================================================

# --- Exécution ---
# NODE_ENV=production active toutes les validations de démarrage.
NODE_ENV=development

# --- Base de données (PostgreSQL / Neon) ---
DATABASE_URL=postgres://arcompt:arcompt@localhost:5432/arcompt

# --- File de tâches ---
REDIS_URL=redis://localhost:6379

# --- ⚠ PRODUCTION — Authentification OIDC (Keycloak) ---
# AUTH_MODE=dev accepte l'en-tête X-Tenant-Id SANS jeton : développement local
# et tests uniquement. La production exige AUTH_MODE=oidc avec KEYCLOAK_ISSUER
# et KEYCLOAK_CLIENT_ID renseignés.
AUTH_MODE=dev
KEYCLOAK_ISSUER=https://auth.example.com/realms/arcompt
KEYCLOAK_CLIENT_ID=arcompt-api
KEYCLOAK_CLIENT_SECRET=

# --- ⚠ PRODUCTION — Stockage des pièces et exports (Cloudflare R2) ---
# Sans ces quatre variables, les pièces vont sur le disque LOCAL du conteneur
# (éphémère) : incompatible avec la conservation décennale AUDCIF.
# Opt-out : ALLOW_INSECURE_STORAGE=1
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=arcompt-dev

# --- ⚠ PRODUCTION — Passerelle IA (Claude, OpenAI ou Gemini) ---
# Choisissez le fournisseur par défaut et, si besoin, un autre fournisseur
# pour l'extraction (capture) ou la catégorisation. Aucune bascule automatique
# en cas d'erreur : un appel échoué reste à traiter manuellement.
# Sans configuration ni clé Anthropic, le développement utilise la simulation :
# fournisseur
# « Fournisseur démo », montants 100000 / 18000 / 118000 et référence inventés,
# qui entrent dans la file de validation puis au grand livre après un seul tap.
# En production, fournissez une clé pour chaque fournisseur choisi. Placez
# les clés dans les Secrets Replit, jamais dans le navigateur ou le dépôt.
# Opt-out de simulation (pré-production uniquement) : ALLOW_INSECURE_AI=1
# AI_PROVIDER=anthropic
AI_CAPTURE_PROVIDER=
AI_CATEGORIZE_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_ANTHROPIC_MODEL=
AI_OPENAI_MODEL=gpt-4o-mini
AI_GEMINI_MODEL=gemini-2.5-flash
AI_PDF_SUPPORT=0

# --- ⚠ PRODUCTION — Canal WhatsApp (Meta Cloud API) ---
# Sans WHATSAPP_TOKEN ET WHATSAPP_PHONE_ID, le canal est simplement désactivé
# (fonction annoncée comme dégradée au démarrage). WHATSAPP_APP_SECRET
# (signature HMAC des webhooks Meta) n'est exigé que si le canal est configuré :
# l'imposer à un déploiement sans WhatsApp poussait surtout à inventer une valeur.
# Opt-out (mock sortant seulement) : ALLOW_INSECURE_WHATSAPP=1
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- ⚠ PRODUCTION — Envoi des e-mails (SMTP, fournisseur au choix) ---
# Sans SMTP_HOST ET MAIL_FROM_ADDRESS, l'expéditeur est NEUTRE : les invitations
# au portail, les demandes de pièces, les notifications d'accès administrateur
# et les relances de règlement sont écrites sur la sortie standard et ne
# quittent pas le serveur.
# Aucun fournisseur n'est nommé par le code : tout service parlant SMTP convient.
# SMTP_SECURE=1 impose TLS dès la connexion (port 465) ; sur 587 ou 25, STARTTLS
# est exigé. Sans SMTP_SECURE, le port décide (465 → TLS implicite).
# ATTENTION : le domaine de MAIL_FROM_ADDRESS doit publier des enregistrements
# SPF et DKIM autorisant ce fournisseur, sinon les messages partiront en
# indésirables ou seront rejetés (voir docs/OPERATIONS.md).
# Ce contrôle n'est pas porté par loadConfig() mais par createMailerFromEnv(),
# appelé au montage des routes : l'API s'arrête au démarrage, avant d'écouter.
# Opt-out : ALLOW_INSECURE_MAIL=1
#
# Boîte retenue pour arcompt.com : Zoho, info@arcompt.com. Le code reste
# agnostique ; ce sont les valeurs de CE déploiement, pas une dépendance.
#
#   ⚠ smtppro, pas smtp. Une adresse sur domaine propre (info@arcompt.com) passe
#     par smtppro.zoho.com. Le smtp.zoho.com des comptes gratuits REFUSE
#     l'authentification d'un compte à domaine : l'erreur ressemble alors à un
#     mot de passe faux et fait chercher au mauvais endroit.
#   ⚠ Suffixe selon le centre de données du compte Zoho, pas selon le pays du
#     dossier : smtppro.zoho.com (US), .eu, .in, .com.au. Le mauvais suffixe
#     donne le même échec d'authentification. Il se lit dans la console Zoho.
#   ⚠ Avec la double authentification activée sur la boîte — et elle doit
#     l'être — SMTP_PASSWORD est un MOT DE PASSE D'APPLICATION créé dans
#     accounts.zoho.com → Sécurité → Mots de passe d'application, jamais le mot
#     de passe de la boîte.
#   ⚠ SMTP_USER doit être l'adresse complète, et Zoho exige qu'elle corresponde
#     à MAIL_FROM_ADDRESS : on n'expédie pas « au nom de » quelqu'un d'autre.
#
# Vérification avant la première vraie invitation : pnpm mail:check
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=info@arcompt.com
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=info@arcompt.com
MAIL_FROM_NAME=ARCOMPT
# Adresse de réponse quand elle diffère de l'expéditeur (boîte suivie par le cabinet).
MAIL_REPLY_TO=
# Mentions légales en pied de CHAQUE message : raison sociale, adresse, RCCM,
# contact. Non renseignées, un texte de rappel part à leur place.
MAIL_LEGAL_FOOTER=

# --- ⚠ PRODUCTION — Antivirus (clamd) ---
# Sans CLAMAV_HOST, le scanner est NEUTRE : tout fichier téléversé est accepté.
# Opt-out : ALLOW_INSECURE_ANTIVIRUS=1
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- ⚠ PRODUCTION — Agrégateur mobile money ---
# MockPaymentProvider est aujourd'hui la SEULE implémentation : elle fabrique
# des encaissements fictifs. Aucun opt-out : la production exige un opérateur
# réel (PAYMENT_PROVIDER différent de « mock »).
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=

# --- ⚠ PRODUCTION — Secret HMAC des webhooks de paiement ---
# 32 caractères minimum, aléatoire, injecté depuis le gestionnaire de secrets.
# La valeur « mock-secret » est explicitement refusée : elle laissait signer un
# événement « payé » à quiconque devinait la référence du lien de paiement.
#   openssl rand -base64 32
PAYMENT_WEBHOOK_SECRET=

# --- ⚠ PRODUCTION — Facture certifiée (FNE / MECeF) ---
# CERTIFICATION_CONNECTOR=mock FABRIQUE une référence de certification fiscale
# et un QR code qui sont IMPRIMÉS sur la facture du client : décommentez-le
# seulement en local. Non renseigné = aucune certification (NullConnector).
# Aucun opt-out : « mock » est refusé en production.
# CERTIFICATION_CONNECTOR=mock

# --- ⚠ PRODUCTION — Paie : clé maître (base64, 32 octets) ---
# Injectée depuis le gestionnaire de secrets. Absente, une clé de développement
# déterministe est utilisée : les données de paie ne sont plus protégées.
#   openssl rand -base64 32
PAYROLL_ENCRYPTION_KEY=

# --- Opt-outs de simulation en production (ALLOW_INSECURE_*) ---
# À ne poser que sciemment, avec NODE_ENV=production. 1, true ou yes activent.
# ALLOW_INSECURE_AI=1          # accepte l'extraction IA simulée
# ALLOW_INSECURE_STORAGE=1     # accepte le stockage local éphémère
# ALLOW_INSECURE_ANTIVIRUS=1   # accepte l'absence d'antivirus
# ALLOW_INSECURE_WHATSAPP=1    # accepte le canal WhatsApp sortant simulé
# ALLOW_INSECURE_MAIL=1        # accepte un expéditeur e-mail muet (rien ne part)
# Pack pays non publié : produit déclarations, liasse DSF et dépôts en les
# marquant « DOCUMENT NON OFFICIEL ». Sans lui, ces opérations sont refusées ;
# la tenue, la facturation et les états financiers restent ouverts.
# ALLOW_INSECURE_DRAFT_PACK_FILINGS=1

# --- Application ---
APP_URL=http://localhost:3000
API_PORT=4000
# Arrêt en douceur : délai laissé aux requêtes en cours avant de fermer le pool
# PostgreSQL. Une écriture comptable est une transaction multi-instructions ;
# la couper laisse un brouillon orphelin. À tenir sous le délai de grâce de
# l'orchestrateur, qui enverra SIGKILL passé le sien.
SHUTDOWN_GRACE_MS=10000
DEFAULT_LOCALE=fr

# --- Stockage local des pièces (sans R2 ; développement uniquement) ---
STORAGE_DIR=./.data/storage
MAX_DOCUMENT_BYTES=15728640

# --- Tâches de fond ---
JOBS_PREFIX=arcompt

# --- Observabilité ---
# OpenTelemetry et Sentry sont installés ; chacun ne démarre que si sa variable
# est renseignée. Sans elles, seuls les journaux structurés restent.
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
# Puits des alertes de sécurité (rafale d'échecs d'authentification, rejet RLS,
# signature de webhook invalide, divergence de règlement). Sans ce collecteur —
# et sans SENTRY_DSN — les signaux restent dans les journaux et ne réveillent
# personne. Le corps posté est expurgé : aucune donnée comptable ni de paie.
SECURITY_ALERT_WEBHOOK_URL=

# --- Web ---
AUTH_SECRET=
DEFAULT_FISCAL_YEAR=2025
DEFAULT_COUNTRY_PACK=ci
DEFAULT_CURRENCY=XOF
