# --- Base de données (PostgreSQL / Neon) ---
DATABASE_URL=postgres://arcompt:arcompt@localhost:5432/arcompt

# --- File de tâches ---
REDIS_URL=redis://localhost:6379

# --- Authentification OIDC (Keycloak) ---
# AUTH_MODE=dev accepte l'en-tête X-Tenant-Id sans jeton : développement local uniquement.
AUTH_MODE=dev
KEYCLOAK_ISSUER=https://auth.example.com/realms/arcompt
KEYCLOAK_CLIENT_ID=arcompt-api
KEYCLOAK_CLIENT_SECRET=

# --- Stockage des pièces et exports (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=arcompt-dev

# --- Passerelle IA (facultatif pour le moteur comptable) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Canal WhatsApp ---
WHATSAPP_API_URL=
WHATSAPP_TOKEN=

# --- Agrégateur mobile money ---
PAYMENT_PROVIDER=
PAYMENT_API_KEY=

# --- Application ---
APP_URL=http://localhost:3000
API_PORT=4000
DEFAULT_LOCALE=fr

# --- Stockage local des pièces (sans R2) ---
STORAGE_DIR=./.data/storage
MAX_DOCUMENT_BYTES=15728640
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- IA ---
AI_PDF_SUPPORT=0

# --- Paie : clé maître (base64, 32 octets) ; injectée depuis le gestionnaire de secrets en production ---
PAYROLL_ENCRYPTION_KEY=

# --- Paiements et facture certifiée ---
PAYMENT_WEBHOOK_SECRET=
CERTIFICATION_CONNECTOR=mock   # connecteur FNE/MECeF simulé en développement

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=

# --- Tâches de fond ---
JOBS_PREFIX=arcompt

# --- Observabilité ---
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# --- Web ---
AUTH_SECRET=
DEFAULT_FISCAL_YEAR=2025
DEFAULT_COUNTRY_PACK=ci
DEFAULT_CURRENCY=XOF
